;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Ficons%2Fimage.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ficons%2Fimage.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ficons%2Fimage.png&amp;w=3840&amp;q=75\"/></div>Cereal &amp; Grain Cleaning</dt></div><div class=\"flex flex-col items-center lg:items-start text-center lg:text-left\"><dt class=\"flex flex-col items-center lg:items-start gap-y-4 text-lg font-semibold leading-7 text-[#324E64]\"><div class=\"w-16 h-16 rounded-2xl bg-white border border-slate-100 shadow-sm flex items-center justify-center p-3 relative overflow-hidden\"><img alt=\"Grading &amp; Sorting Machines\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain p-2\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Ficons%2Fimage1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ficons%2Fimage1.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ficons%2Fimage1.png&amp;w=3840&amp;q=75\"/></div>Grading &amp; Sorting Machines</dt></div><div class=\"flex flex-col items-center lg:items-start text-center lg:text-left\"><dt class=\"flex flex-col items-center lg:items-start gap-y-4 text-lg font-semibold leading-7 text-[#324E64]\"><div class=\"w-16 h-16 rounded-2xl bg-white border border-slate-100 shadow-sm flex items-center justify-center p-3 relative overflow-hidden\"><img alt=\"Elevators &amp; Conveyors\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain p-2\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Ficons%2Fimage3.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ficons%2Fimage3.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ficons%2Fimage3.png&amp;w=3840&amp;q=75\"/></div>Elevators &amp; Conveyors</dt></div><div class=\"flex flex-col items-center lg:items-start text-center lg:text-left\"><dt class=\"flex flex-col items-center lg:items-start gap-y-4 text-lg font-semibold leading-7 text-[#324E64]\"><div class=\"w-16 h-16 rounded-2xl bg-white border border-slate-100 shadow-sm flex items-center justify-center p-3 relative overflow-hidden\"><img alt=\"Peanut Husk Separator\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain p-2\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Ficons%2Fimage2.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Ficons%2Fimage2.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Ficons%2Fimage2.png&amp;w=3840&amp;q=75\"/></div>Peanut Husk Separator</dt></div></dl></div></div></div><div class=\"pt-24 pb-12 sm:py-32\"><div class=\"mx-auto max-w-7xl px-6 lg:px-8\"><div class=\"mx-auto grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:gap-y-20 lg:mx-0 lg:max-w-none lg:grid-cols-2 lg:items-start\"><div class=\"lg:pr-4\"><div class=\"lg:max-w-lg\"><h2 class=\"text-base font-semibold leading-7 text-[#F3BA43]\">Expertise</h2><p class=\"mt-2 text-3xl font-bold tracking-tight text-[#324E64] sm:text-4xl\">35+ Years of Engineering Excellence</p><div class=\"mt-10 max-w-xl text-base leading-7 text-slate-600\">With decades of expertise in agro-food engineering, we bring trusted experience and proven innovation to every solution we create. Our machines are built to handle groundnuts, food grains, pulses, oilseeds, and spices/condiments, ensuring cleaner produce, safer operations, and lasting performance.</div><div class=\"relative h-64 w-full rounded-2xl overflow-hidden mt-8 shadow-sm border border-slate-100\"><img alt=\"A close-up photograph showing a large quantity of raw shelled peanuts with reddish-brown skins.\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fimages%2Fcontext%2Fraw-peanuts-closeup.jpg&amp;w=3840&amp;q=75\"/></div><h3 class=\"mt-8 text-2xl font-bold tracking-tight text-[#324E64]\">What We Stand For</h3><p class=\"mt-4 text-base leading-7 text-slate-600\">Our commitment lies in delivering trust through technology. Each of our solutions is crafted to ensure purity, performance, and perfection. redefining quality standards for the global food and FMCG industries.</p><ul role=\"list\" class=\"mt-8 space-y-4 text-slate-600\"><li class=\"flex gap-x-3\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" aria-hidden=\"true\" class=\"remixicon mt-1 h-5 w-5 flex-none text-[#F3BA43]\"><path d=\"M11.602 13.7599L13.014 15.1719L21.4795 6.7063L22.8938 8.12051L13.014 18.0003L6.65 11.6363L8.06421 10.2221L10.189 12.3469L11.6025 13.7594L11.602 13.7599ZM11.6037 10.9322L16.5563 5.97949L17.9666 7.38977L13.014 12.3424L11.6037 10.9322ZM8.77698 16.5873L7.36396 18.0003L1 11.6363L2.41421 10.2221L3.82723 11.6352L3.82604 11.6363L8.77698 16.5873Z\"></path></svg><span>Supporting cleaner, safer, and healthier food systems</span></li><li class=\"flex gap-x-3\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" aria-hidden=\"true\" class=\"remixicon mt-1 h-5 w-5 flex-none text-[#F3BA43]\"><path d=\"M11.602 13.7599L13.014 15.1719L21.4795 6.7063L22.8938 8.12051L13.014 18.0003L6.65 11.6363L8.06421 10.2221L10.189 12.3469L11.6025 13.7594L11.602 13.7599ZM11.6037 10.9322L16.5563 5.97949L17.9666 7.38977L13.014 12.3424L11.6037 10.9322ZM8.77698 16.5873L7.36396 18.0003L1 11.6363L2.41421 10.2221L3.82723 11.6352L3.82604 11.6363L8.77698 16.5873Z\"></path></svg><span>Innovative designs to meet tomorrow’s food challenges</span></li><li class=\"flex gap-x-3\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" aria-hidden=\"true\" class=\"remixicon mt-1 h-5 w-5 flex-none text-[#F3BA43]\"><path d=\"M11.602 13.7599L13.014 15.1719L21.4795 6.7063L22.8938 8.12051L13.014 18.0003L6.65 11.6363L8.06421 10.2221L10.189 12.3469L11.6025 13.7594L11.602 13.7599ZM11.6037 10.9322L16.5563 5.97949L17.9666 7.38977L13.014 12.3424L11.6037 10.9322ZM8.77698 16.5873L7.36396 18.0003L1 11.6363L2.41421 10.2221L3.82723 11.6352L3.82604 11.6363L8.77698 16.5873Z\"></path></svg><span>Scalable solutions for diverse food processing industries</span></li><li class=\"flex gap-x-3\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" aria-hidden=\"true\" class=\"remixicon mt-1 h-5 w-5 flex-none text-[#F3BA43]\"><path d=\"M11.602 13.7599L13.014 15.1719L21.4795 6.7063L22.8938 8.12051L13.014 18.0003L6.65 11.6363L8.06421 10.2221L10.189 12.3469L11.6025 13.7594L11.602 13.7599ZM11.6037 10.9322L16.5563 5.97949L17.9666 7.38977L13.014 12.3424L11.6037 10.9322ZM8.77698 16.5873L7.36396 18.0003L1 11.6363L2.41421 10.2221L3.82723 11.6352L3.82604 11.6363L8.77698 16.5873Z\"></path></svg><span>Enhancing productivity across the food supply chain</span></li></ul></div></div><div class=\"bg-[#1E3448] rounded-3xl p-8 sm:p-10 lg:p-12 shadow-2xl\"><h3 class=\"text-xl font-semibold leading-7 text-white mb-8\">Client Reviews</h3><div class=\"space-y-8\"><figure class=\"border-l-2 border-[#F3BA43] pl-6\"><div class=\"flex gap-1 text-[#F3BA43] mb-2\"><svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\" class=\"remixicon h-4 w-4\"><path d=\"M11.9998 17L6.12197 20.5902L7.72007 13.8906L2.48926 9.40983L9.35479 8.859